<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/profileTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student Profile"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/profileName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👤 Himanshu Choudhary"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/profileTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="40dp" />

    <TextView
        android:id="@+id/profileCourse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎓 B.Tech CSE"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/profileName"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="18dp" />

    <TextView
        android:id="@+id/profileCollege"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏫 GITS Udaipur"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/profileCourse"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="18dp" />

    <TextView
        android:id="@+id/profileSkills"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💻 Skills: C, C++, Python, HTML, CSS, JavaScript"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/profileCollege"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="18dp" />

</androidx.constraintlayout.widget.ConstraintLayout>